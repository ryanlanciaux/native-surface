{
  "name": "@native-surface/e2e",
  "version": "0.1.0-alpha.2",
  "description": "TesterArmy e2e engine and reusable browser automation bridge for canvas React Native surfaces.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/ryanlanciaux/native-surface.git", "directory": "packages/e2e" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./browser": { "types": "./dist/browser.d.ts", "default": "./dist/browser.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "preview": "vite --config vite.preview.config.ts",
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts src/browser.ts --outdir=dist --format=esm --platform=node --packages=external --bundle",
    "typecheck": "tsc --noEmit && tsc --noEmit -p visual",
    "test": "pnpm run build && vitest run",
    "test:visual": "e2e run --config visual/e2e.config.ts",
    "test:visual:update": "e2e run --config visual/e2e.config.ts --update-snapshots",
    "prepack": "pnpm run build"
  },
  "peerDependencies": { "e2e": ">=0.19.0 <0.23.0" },
  "dependencies": { "playwright": "^1.63.0", "pngjs": "^7.0.0" },
  "devDependencies": {
    "e2e": "0.19.0",
    "native-surface": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.0.0"
  },
  "engines": { "node": ">=22.12.0" },
  "publishConfig": { "access": "public" }
}
