{
  "name": "native-surface",
  "version": "0.1.0-alpha.0",
  "license": "MIT",
  "description": "Run real React Native component trees inside any React DOM app - a canvas renderer (Yoga WASM layout + Skia/CanvasKit paint, custom reconciler) with a one-call Vite preset. Not react-native-web.",
  "keywords": [
    "react-native",
    "canvas",
    "skia",
    "yoga",
    "wasm",
    "embed",
    "vite",
    "renderer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanlanciaux/native-surface.git"
  },
  "homepage": "https://github.com/ryanlanciaux/native-surface#readme",
  "bugs": "https://github.com/ryanlanciaux/native-surface/issues",
  "files": [
    "src",
    "dist",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "build:vite-helper": "esbuild src/vite.ts --format=esm --platform=node --outfile=dist/vite.mjs",
    "prepack": "pnpm run build:vite-helper"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@native-surface/compat": "workspace:*",
    "canvaskit-wasm": "^0.40.0",
    "react-reconciler": "^0.33.0",
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-reconciler": "^0.32.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "esbuild": "^0.25.0",
    "vite": "^6.4.3",
    "@babel/core": "^7.29.7",
    "@types/babel__core": "^7.20.5"
  },
  "publishConfig": {
    "exports": {
      ".": "./src/index.ts",
      "./vite": {
        "types": "./src/vite.ts",
        "default": "./dist/vite.mjs"
      },
      "./assets/*": "./assets/*",
      "./package.json": "./package.json"
    }
  }
}
