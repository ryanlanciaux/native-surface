{
  "name": "@native-surface/playground",
  "version": "0.1.0-alpha.3",
  "license": "MIT",
  "description": "Component playground for native-surface: serve any React Native app's stories on the canvas engine - real Yoga layout, Skia paint, shareable URLs, no device.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanlanciaux/native-surface.git",
    "directory": "packages/playground"
  },
  "type": "module",
  "bin": {
    "native-surface-playground": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    ".native-surface",
    "index.html",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@native-surface/design-plane": "workspace:*",
    "@vitejs/plugin-react": "^4.3.0",
    "native-surface": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
