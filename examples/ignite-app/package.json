{
  "name": "ignite-demo",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "An Ignite-style React Native demo app (React Native Radio podcast browser + component showroom) that runs on native-surface.",
  "exports": {
    ".": "./src/index.ts",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config dev/vite.config.ts",
    "build": "vite build --config dev/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests in ignite-demo'"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "native-surface": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
