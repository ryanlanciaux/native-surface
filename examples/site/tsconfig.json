      "@assets/*": ["../ignite-app/assets/*"],
      "expo": ["../../packages/compat/src/expo.tsx"],
      "expo-linking": ["../../packages/compat/src/expo.tsx"],
      "expo-localization": ["../../packages/compat/src/expo.tsx"],
      "expo-application": ["../../packages/compat/src/expo.tsx"],
